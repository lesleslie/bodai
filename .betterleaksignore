# Exclude third-party dependency caches and tooling artifacts from secret scans.
# Patterns follow gitleaksignore syntax (filepath|glob|regex per line).
# DO NOT add local config or credential files here — that would create a
# backdoor for credential exposure.

# Crackerjack uv cache holds third-party source tarballs we don't own.
.crackerjack/uv/cache/**

# Coverage reports may echo test fixtures with hardcoded creds.
htmlcov/**
.coverage
coverage.json